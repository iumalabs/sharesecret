# Copy to .dev.vars for local development (wrangler dev reads .dev.vars).
# .dev.vars is gitignored -- never commit real secrets.
#
# Production secrets are set via `wrangler secret put <NAME>`, never
# committed to this repo and never stored in wrangler.jsonc.

# HMAC pepper mixed into PIN hashing on top of PBKDF2 (defense in depth if
# the D1 database is ever exfiltrated). Generate with:
#   openssl rand -base64 32
PIN_HASH_PEPPER=

# Comma-separated list of allowed origins for CORS / link generation.
ALLOWED_ORIGINS=http://localhost:5173
