{
  "nodeModulesDir": "auto",
  "imports": {
    "hono": "npm:hono@^4.13.0",
    "qrcode": "npm:qrcode@^1.5.4",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-dom/client": "npm:react-dom@^19.2.8/client",
    "@axe-core/playwright": "npm:@axe-core/playwright@^4.12.1",
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@^1.50.0",
    "@cloudflare/vitest-pool-workers": "npm:@cloudflare/vitest-pool-workers@^0.20.1",
    "@playwright/test": "npm:@playwright/test@^1.62.1",
    "@types/node": "npm:@types/node@^24.13.3",
    "@types/qrcode": "npm:@types/qrcode@^1.5.6",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.0.4",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@^7.1.12",
    "vitest": "npm:vitest@^4.1.10",
    "wrangler": "npm:wrangler@^4.118.0"
  },
  "tasks": {
    "dev": "deno run -A npm:vite dev --config src/react-app/vite.config.ts",
    "build": "deno run -A npm:vite build --config src/react-app/vite.config.ts",
    "preview": "deno run -A npm:vite preview --config src/react-app/vite.config.ts",
    "deploy": "deno task build && deno run -A npm:wrangler deploy",
    "cf-typegen": "deno run -A npm:wrangler types",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "typecheck": "DENO_COMPAT=1 deno check src/worker/**/*.ts src/shared/**/*.ts && DENO_COMPAT=1 deno check src/react-app/**/*.ts src/react-app/**/*.tsx",
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    "test:e2e": "deno run -A npm:playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "deno run -A npm:playwright test --config e2e/playwright.config.ts --ui",
    "db:migrate:local": "deno run -A npm:wrangler d1 migrations apply sharesecret-db --local",
    "db:migrate:remote": "deno run -A npm:wrangler d1 migrations apply sharesecret-db --remote",
    "gen-dev-vars": "deno run --allow-read --allow-write scripts/gen-dev-vars.ts"
  },
  "allowScripts": ["npm:workerd"],
  "workspace": ["src/worker", "src/react-app"],
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "dist",
      ".wrangler",
      "worker-configuration.d.ts",
      "deno.lock",
      "e2e/test-results",
      "e2e/playwright-report"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "react"],
      // no-window/no-window-prefix assume Deno-as-runtime code (where
      // `window` doesn't exist -- use `globalThis`). This is a browser-facing
      // SPA: `window` is correct, idiomatic, and expected throughout
      // src/react-app/ and inside Playwright's page.evaluate() callbacks in
      // e2e/. The Worker/DOM boundary these rules would otherwise gesture at
      // is already enforced more precisely by `deno check` -- see
      // src/worker/deno.json's restricted `lib`, verified with a negative
      // control (SS-002).
      "exclude": ["no-window", "no-window-prefix"]
    },
    "exclude": ["dist", ".wrangler", "worker-configuration.d.ts"]
  }
}
